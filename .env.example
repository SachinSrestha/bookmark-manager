# ==========================================================
# Environment Variables for Local Development / Docker
# Copy this file to .env before starting:
#   cp .env.example .env     (Linux / Mac)
#   copy .env.example .env   (Windows)
# ==========================================================

DEBUG=True
SECRET_KEY=change-me-to-any-random-secret-key-for-local-use

# Database configuration (defaults connect to Docker Postgres service)
# For Docker: these defaults are correct as-is (DB_HOST=db is the Compose
# service name; DB_PORT=5432 is the container's internal port).
# For non-Docker local dev: change DB_HOST=localhost and DB_PORT=5433
# (the host-mapped port from docker-compose.yml's "5433:5432" — only
# needed if you're running Postgres via this project's docker-compose.yml
# but connecting to it from a non-Docker Django process on your host).
DB_NAME=bookmarks
DB_USER=postgres
DB_PASSWORD=pass
DB_HOST=db
DB_PORT=5432

# Redis & Celery broker (connects to Docker Redis service)
REDIS_URL=redis://redis:6379/0
